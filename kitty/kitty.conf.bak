# Ported from ~/.config/wezterm (wezterm.lua / fonts.lua / themes.lua / keys.lua)

include other.conf
# include dark-theme.auto.conf
include light-theme.auto.conf

#: Font --------------------------------------------------------------
#: fonts.lua: iosevka @ monitor -> size 23, line_height 1.1, weight 500 (Medium)

bold_font        Iosevka Term Extrabold
font_family      Iosevka Term Medium
italic_font      Iosevka Term Medium Italic
bold_italic_font Iosevka Term Extrabold Italic

font_size 23.0

#: line_height = 1.0 -> +10% cell height
modify_font cell_height 110%

#: Window ------------------------------------------------------------
confirm_os_window_close 0
macos_quit_when_last_window_closed yes
macos_traditional_fullscreen no
macos_option_as_alt no

hide_window_decorations titlebar-only
window_padding_width 0
background_opacity 1.0
background_blur 10

#: Tabs --------------------------------------------------------------
tab_bar_edge          bottom
tab_bar_style         powerline
tab_powerline_style   slanted
tab_bar_min_tabs      2
tab_title_template    "{index}: {title}"

active_tab_foreground   #f8f8f8
active_tab_background   #2a2a2a
active_tab_font_style   bold
inactive_tab_foreground #7a7a7a
inactive_tab_background #dedede
inactive_tab_font_style normal
tab_bar_background      #f8f8f8

#: kitty always fills the window with the background color, so the
#: partial-cell remainder that wezterm needed a workaround for is
#: already handled here.

#: Colors: Mexico Light (base16) -------------------------------------
# background            #f8f8f8
# foreground            #2a2a2a
# selection_background  #dedede
# selection_foreground  #2a2a2a
# cursor                #2a2a2a
# cursor_text_color     #f8f8f8
# url_color             #7b59c0

# black
# color0  #f8f8f8
# color8  #7a7a7a
# red
# color1  #ab4642
# color9  #ab4642
# green
# color2  #538947
# color10 #538947
# yellow
# color3  #f79a0e
# color11 #f79a0e
# blue
# color4  #7cafc2
# color12 #7cafc2
# magenta
# color5  #96609e
# color13 #96609e
# cyan
# color6  #4b8093
# color14 #4b8093
# white
# color7  #2a2a2a
# color15 #2a2a2a

#: Keys --------------------------------------------------------------
#: keys.lua leader = CTRL+; -> kitty keyboard mode "leader"

#: splits require the "splits" layout
enabled_layouts splits,stack

#: leader = ctrl+;  (--on-unknown end: any other key exits the mode)
map --new-mode leader --on-unknown end ctrl+semicolon

map --mode leader plus   combine : pop_keyboard_mode : launch --location=hsplit --cwd=current
map --mode leader minus  combine : pop_keyboard_mode : launch --location=vsplit --cwd=current

map --mode leader h      combine : pop_keyboard_mode : neighboring_window left
map --mode leader l      combine : pop_keyboard_mode : neighboring_window right
map --mode leader k      combine : pop_keyboard_mode : neighboring_window up
map --mode leader j      combine : pop_keyboard_mode : neighboring_window down

map --mode leader q      combine : pop_keyboard_mode : close_window_with_confirmation

map --mode leader esc    pop_keyboard_mode

#: tabs
map cmd+t            new_tab_with_cwd
map cmd+w            close_tab
map cmd+shift+left   move_tab_backward
map cmd+shift+right  move_tab_forward
map cmd+shift+t      set_tab_title

map ctrl+shift+right next_tab
map ctrl+shift+left  previous_tab

map cmd+1 goto_tab 1
map cmd+2 goto_tab 2
map cmd+3 goto_tab 3
map cmd+4 goto_tab 4
map cmd+5 goto_tab 5
map cmd+6 goto_tab 6
map cmd+7 goto_tab 7
map cmd+8 goto_tab 8
map cmd+9 goto_tab 9

#: tabs via leader (c/n/p/, like tmux)
map --mode leader c  combine : pop_keyboard_mode : new_tab_with_cwd
map --mode leader n  combine : pop_keyboard_mode : next_tab
map --mode leader p  combine : pop_keyboard_mode : previous_tab
map --mode leader comma combine : pop_keyboard_mode : set_tab_title
