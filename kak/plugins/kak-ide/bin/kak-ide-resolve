#!/bin/sh
# kak-ide — goto-file / import resolution  (plan Section 7.3)
#
#   kak-ide-resolve <root> <buffile> <filetype> <line>
#
# Prints resolved absolute paths, one per line, best candidate first. Prints
# nothing when it cannot resolve — the caller then falls back to LSP
# goto-definition, which handles bare package specifiers and external crates
# far better than filesystem probing ever will.
#
# Per §7.3 these resolvers are the FALLBACK, not the primary: rust-analyzer and
# tsserver both resolve an import specifier via goto-definition. This exists for
# positions with no running server, and for files types no server covers.
set -eu

[ $# -ge 4 ] || { echo "usage: kak-ide-resolve <root> <buffile> <filetype> <line>" >&2; exit 2; }
root=$1; buffile=$2; ft=$3; line=$4
dir=$(dirname "$buffile")

# Normalise ./ and ../ out of a path. BSD has no realpath(1) and the file may
# not exist yet, so do it textually.
norm() {
    p=$1
    p=$(printf '%s' "$p" | sed -e 's|/\./|/|g' -e 's|//*|/|g')
    while :; do
        case "$p" in
            */../*) p=$(printf '%s' "$p" | sed -e 's|/[^/][^/]*/\.\./|/|') ;;
            *) break ;;
        esac
    done
    printf '%s' "$p"
}

emit() { n=$(norm "$1"); [ -e "$n" ] && printf '%s\n' "$n" || true; }

# First quoted string on the line: "x" or 'x'.
quoted() {
    printf '%s' "$line" | sed -n 's/.*"\([^"]*\)".*/\1/p; ' | head -1
    printf '%s' "$line" | sed -n "s/.*'\([^']*\)'.*/\1/p" | head -1
}

# ── JS / TS family ───────────────────────────────────────────────────────────
resolve_js() {
    spec=$(quoted | head -1)
    [ -n "$spec" ] || return 0
    case "$spec" in
        ./*|../*)
            base="$dir/$spec" ;;
        /*)
            base="$spec" ;;
        *)
            # Bare specifier: try tsconfig/jsconfig "paths" before node_modules.
            for cfg in "$root/tsconfig.json" "$root/jsconfig.json"; do
                [ -f "$cfg" ] || continue
                mapped=$(KI_SPEC="$spec" KI_ROOT="$root" python3 - "$cfg" <<'PY' 2>/dev/null || true
import json, os, re, sys
raw = open(sys.argv[1]).read()
raw = re.sub(r'/\*.*?\*/', '', raw, flags=re.S)      # tsconfig is JSONC
raw = re.sub(r'(?m)//.*$', '', raw)
raw = re.sub(r',(\s*[}\]])', r'\1', raw)             # trailing commas
try:
    cfg = json.loads(raw).get('compilerOptions', {})
except Exception:
    sys.exit(0)
spec, root = os.environ['KI_SPEC'], os.environ['KI_ROOT']
base = os.path.join(root, cfg.get('baseUrl', '.'))
for pat, targets in (cfg.get('paths') or {}).items():
    if '*' in pat:
        pre, post = pat.split('*', 1)
        if spec.startswith(pre) and spec.endswith(post):
            mid = spec[len(pre):len(spec)-len(post) or None]
            for t in targets:
                print(os.path.normpath(os.path.join(base, t.replace('*', mid))))
    elif pat == spec:
        for t in targets:
            print(os.path.normpath(os.path.join(base, t)))
PY
                )
                if [ -n "$mapped" ]; then
                    printf '%s\n' "$mapped" | while IFS= read -r m; do try_js_ext "$m"; done
                    return 0
                fi
            done
            # node_modules fallback: the package's own entry point.
            pkg="$root/node_modules/$spec"
            [ -d "$pkg" ] && { emit "$pkg/index.js"; emit "$pkg/index.ts"; emit "$pkg/package.json"; }
            return 0 ;;
    esac
    try_js_ext "$base"
}

try_js_ext() {
    b=$1
    # Exact file first, then TypeScript before JavaScript (a .ts and its build
    # output .js often sit side by side; the source is what you want), then the
    # directory's index.
    nb=$(norm "$b"); [ -f "$nb" ] && { printf '%s\n' "$nb"; return 0; }
    for e in .ts .tsx .d.ts .js .jsx .mjs .cjs .json; do emit "$b$e"; done
    for e in /index.ts /index.tsx /index.js /index.jsx; do emit "$b$e"; done
}

# ── Rust ─────────────────────────────────────────────────────────────────────
resolve_rust() {
    # `mod foo;` -> sibling foo.rs or foo/mod.rs
    m=$(printf '%s' "$line" | sed -nE 's/^[[:space:]]*(pub[[:space:]]+)?mod[[:space:]]+([A-Za-z_][A-Za-z0-9_]*).*/\2/p')
    if [ -n "$m" ]; then
        emit "$dir/$m.rs"; emit "$dir/$m/mod.rs"
        return 0
    fi
    # `use crate::a::b::c;` / `use self::..` / `use super::..`
    u=$(printf '%s' "$line" | sed -nE 's/^[[:space:]]*(pub[[:space:]]+)?use[[:space:]]+([A-Za-z_][A-Za-z0-9_:]*).*/\2/p')
    [ -n "$u" ] || return 0
    case "$u" in
        crate::*) rel=${u#crate::}; base=$(crate_root) ;;
        self::*)  rel=${u#self::};  base="$dir" ;;
        super::*) rel=${u#super::}; base=$(dirname "$dir") ;;
        *) return 0 ;;   # external crate -> let the LSP handle it
    esac
    path=$(printf '%s' "$rel" | sed 's/::/\//g')
    # The last segment may be an item inside the parent module, not a file.
    emit "$base/$path.rs"; emit "$base/$path/mod.rs"
    parent=$(dirname "$path")
    [ "$parent" != "." ] && { emit "$base/$parent.rs"; emit "$base/$parent/mod.rs"; }
    return 0
}

crate_root() {
    d=$dir
    while [ "$d" != "/" ] && [ -n "$d" ]; do
        [ -d "$d/src" ] && [ -f "$d/Cargo.toml" ] && { printf '%s' "$d/src"; return; }
        d=$(dirname "$d")
    done
    printf '%s' "$root/src"
}

# ── Lua ──────────────────────────────────────────────────────────────────────
resolve_lua() {
    spec=$(quoted | head -1)
    [ -n "$spec" ] || return 0
    p=$(printf '%s' "$spec" | tr '.' '/')
    for b in "$dir" "$root" "$root/lua" "$root/src"; do
        emit "$b/$p.lua"; emit "$b/$p/init.lua"
    done
}

# ── HTML / CSS assets ────────────────────────────────────────────────────────
resolve_asset() {
    # url(...) first, since it is not quoted in the common case
    spec=$(printf '%s' "$line" | sed -nE 's/.*url\([[:space:]]*["'"'"']?([^)"'"'"']*).*/\1/p' | head -1)
    [ -n "$spec" ] || spec=$(quoted | head -1)
    [ -n "$spec" ] || return 0
    case "$spec" in
        http://*|https://*|data:*|'#'*) return 0 ;;   # not a local file
        /*) emit "$root$spec"; emit "$spec" ;;
        *)  emit "$dir/$spec"
            [ "$ft" = css ] && emit "$dir/$spec.css"
            emit "$root/$spec" ;;
    esac
}

dispatch() {
case "$ft" in
    javascript|typescript|jsx|tsx) resolve_js ;;
    rust)                          resolve_rust ;;
    lua)                           resolve_lua ;;
    html|css|scss|less)            resolve_asset ;;
    *)  # Unknown filetype: treat any quoted string as a relative path.
        spec=$(quoted | head -1)
        [ -n "$spec" ] && { emit "$dir/$spec"; emit "$root/$spec"; } ;;
esac
}

# Order is meaningful (best candidate first), so dedup without sorting.
dispatch | awk '!seen[$0]++'
