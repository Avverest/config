try %{ 

    # These modules declare the options set below, so load them up front.
    # The rarer pickers (buffers, recent, projects, vcs) stay lazy.
    require-module fzf
    require-module fzf-file
    require-module fzf-grep

    set-option global fzf_implementation      'fzf'
    set-option global fzf_file_command        'fd --type f --follow --hidden --exclude .git'
    set-option global fzf_grep_command        'rg --line-number --no-column --no-heading --color=never --smart-case '''''
    set-option global fzf_preview             true

    # PREVIEW COMMAND — the `{}` matters.
    # fzf.kak special-cases the names bat/coderay/highlight/rouge/clp and passes
    # anything else through verbatim into `--preview '(<cmd> || cat {})'`. A bare
    # `cat` therefore becomes `cat` with NO argument, which reads stdin and
    # renders an empty preview pane. The fallback must name the file itself.
    set-option global fzf_highlight_command %sh{
        if command -v bat >/dev/null 2>&1; then
            echo 'bat --color=always --style=numbers --paging=never {}'
        else
            echo 'cat {}'
        fi
    }
    set-option global fzf_grep_preview_command %sh{ command -v bat >/dev/null 2>&1 && echo bat || echo cat }

    # PREVIEW LAYOUT — 35% file list / 65% preview.
    # `fzf_preview_pos auto` flips between a right split and a top split based on
    # the terminal's aspect ratio, so the width setting only applied some of the
    # time. Pin it to `right` so the 65% is what you actually get.
    set-option global fzf_preview_pos    'right'
    set-option global fzf_preview_width  '65%'
    set-option global fzf_preview_height '65%'   ;# used if pos is ever set to top/bottom

    # WINDOW SIZE.
    # Under tmux, fzf.kak does NOT use `fzf_terminal_command` at all: it builds
    # a `tmux split-window` itself so it can pass a size, which `terminal`
    # cannot take (see the comment at fzf.kak/rc/fzf.kak:235). So the size comes
    # from its own options, not from a wrapper command — an earlier wezterm
    # wrapper here was dead code under tmux for exactly this reason.
    #
    # Two heights, because fzf.kak picks between them: the preview one wins
    # whenever a picker was invoked with -preview, which is all of ours.
    set-option global fzf_preview_tmux_height '70%'
    set-option global fzf_tmux_height         '40%'

    # Shell snippet shared by the project-scoped commands below: sets $root to
    # the VCS root of the current buffer, falling back to a marker file, then
    # to the server's working directory.
    declare-option -hidden str fzf_project_root_sh %{
        dir="${kak_buffile%/*}"
        [ -d "$dir" ] || dir="$PWD"
        root=$(cd "$dir" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)
        if [ -z "$root" ]; then
            d="$dir"
            while [ -n "$d" ] && [ "$d" != "/" ]; do
                for marker in .git .hg .svn .jj .project-root package.json go.mod Cargo.toml pyproject.toml Makefile; do
                    if [ -e "$d/$marker" ]; then root="$d"; break 2; fi
                done
                d="${d%/*}"
            done
        fi
        [ -n "$root" ] || root="$PWD"
    }

    define-command -docstring "fzf-project-files: fuzzy-find files under the current project root" \
    fzf-project-files %{
        require-module fzf
        evaluate-commands %sh{
            eval "$kak_opt_fzf_project_root_sh"
            if command -v fd >/dev/null 2>&1; then
                items="fd --type f --follow --hidden --exclude .git"
            elif command -v rg >/dev/null 2>&1; then
                items="rg -L --hidden --files --glob '!.git/*'"
            else
                items="find -L . -type f -not -path '*/.git/*'"
            fi
            printf "%s\n" "info -title %{fzf project files} %{root: ${root}}"
            printf "%s\n" "fzf -kak-cmd %{edit -existing} -preview -items-cmd %{cd '${root}' && ${items}} -filter %{sed 's|^|${root}/|'} -fzf-args %{--reverse}"
        }
    }

    define-command -docstring "fzf-project-grep: fuzzy-search file contents under the current project root" \
    fzf-project-grep %{
        require-module fzf
        evaluate-commands %sh{
            eval "$kak_opt_fzf_project_root_sh"
            # Stream only what matches, not the whole tree. The obvious form —
            # an empty rg pattern, letting fzf fuzzy-match every line — emits
            # 9.5M lines / 1.0GB on a 25k-file checkout and takes 1.6s before
            # fzf starts, blowing plan §10's "well under a second" bar. With
            # --disabled + reload, fzf stops matching and each keystroke re-runs
            # rg instead: 0.03-0.5s per query on the same tree.
            #
            # --max-count caps per-file hits so one generated/minified file
            # cannot flood the list. The output shape is unchanged, so -filter
            # and the preview command below still apply verbatim.
            if command -v rg >/dev/null 2>&1; then
                rg_cmd="rg --line-number --no-column --no-heading --color=never --smart-case --max-count=50"
                items="${rg_cmd} -- '' | head -n 2000"
                reload="--disabled --bind 'start:reload:${rg_cmd} -- {q} 2>/dev/null | head -n 2000' --bind 'change:reload:sleep 0.05; ${rg_cmd} -- {q} 2>/dev/null | head -n 2000'"
            else
                items="grep -RHn '' . | head -n 2000"
                reload=""
            fi
            if command -v bat >/dev/null 2>&1; then
                preview="-preview -preview-cmd %{--preview '(bat --color=always --style=plain --highlight-line {2} ${root}/{1} || cat ${root}/{1}) 2>/dev/null' --preview-window=\${pos}:+{2}-/2}"
            else
                preview="-preview -preview-cmd %{--preview 'cat ${root}/{1} 2>/dev/null' --preview-window=\${pos}:+{2}-/2}"
            fi
            printf "%s\n" "info -title %{fzf project grep} %{root: ${root}}"
            printf "%s\n" "fzf -kak-cmd %{evaluate-commands} ${preview} -items-cmd %{cd '${root}' && ${items} 2>/dev/null} -filter %{sed -E 's|([^:]+):([^:]+):.*|edit -existing ${root}/\\1; execute-keys \\2gvc|'} -fzf-args %{--reverse --delimiter=':' -n'3..' ${reload}}"
        }
    }

    # ── Bindings ──
    # <c-p> is the one key worth stealing from normal mode: it is only bound in
    # insert mode (previous completion). <c-f> (page down) and <c-g> (cancel a
    # long-running operation) are deliberately left alone; the rest of the
    # pickers hang off the `,` leader menu below.
    map global normal <c-p> ': fzf-project-files<ret>' -docstring 'find file in project'

    # Project-scoped entries inside the fzf menu itself (,z or :fzf-mode),
    # alongside its built-ins: f file, b buffer, g grep, v git, r recent, c cd.
    map global fzf 'P' ': fzf-project-files<ret>' -docstring 'find file in project (VCS root)'
    map global fzf 'G' ': fzf-project-grep<ret>'  -docstring 'grep in project (VCS root)'
 } catch %{
    echo -debug "Error while evaluating 'fzf.kak' configuration: %val{error}"

    set-option -add current plug_conf_errors "Error while evaluating 'fzf.kak' configuration:"
    set-option -add current plug_conf_errors %sh{ printf "\n    " }
    set-option -add current plug_conf_errors %val{error}
    set-option -add current plug_conf_errors %sh{ printf "\n\n" }

    hook -once -group plug-conf-err global WinDisplay .* %{
        info -style modal -title "plug.kak error" "%opt{plug_conf_errors}"
        on-key %{
            info -style modal
            execute-keys -with-maps -with-hooks %val{key}
        }
    }
}
