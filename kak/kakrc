# ─────────────────────────────────────────────────────────────────────────────
# General editor behaviour
# ─────────────────────────────────────────────────────────────────────────────
set-option global tabstop 4
set-option global indentwidth 4
set-option global scrolloff 3,3
set-option -add global ui_options terminal_assistant=cat

evaluate-commands %sh{ command -v rg >/dev/null 2>&1 && echo "set-option global grepcmd 'rg --column --line-number --no-heading --smart-case'" }

# ─────────────────────────────────────────────────────────────────────────────
# Plugins (plug.kak) — bootstrapped on first start, then `:plug-install`
# ─────────────────────────────────────────────────────────────────────────────
evaluate-commands %sh{
    plugins="$kak_config/plugins"
    mkdir -p "$plugins"
    [ ! -e "$plugins/plug.kak" ] && \
        git clone -q https://github.com/andreyorst/plug.kak.git "$plugins/plug.kak"
    printf "%s\n" "source '$plugins/plug.kak/rc/plug.kak'"
}
plug "andreyorst/plug.kak" noload

# ─────────────────────────────────────────────────────────────────────────────
# Appearance
# ─────────────────────────────────────────────────────────────────────────────
add-highlighter global/ number-lines -relative -hlcursor
add-highlighter global/ show-matching
add-highlighter global/ wrap -word -indent
add-highlighter global/ regex \h+$ 0:Error

declare-option -hidden str kak_ig_style spaces

define-command -hidden kak-indent-guides-apply %{
    evaluate-commands -draft %{
        set-option window kak_ig_style spaces
        try %{
            execute-keys '%s^\t<ret>'
            set-option window kak_ig_style tabs
        }
    }
    evaluate-commands %sh{
        : "$kak_opt_kak_ig_style"
        if [ "$kak_opt_kak_ig_style" = tabs ]; then
            printf "add-highlighter -override window/indent-guides show-whitespaces -tab '│' -tabpad ' ' -lf ' ' -spc ' ' -nbsp ' '\n"
        else
            printf "add-highlighter -override window/indent-guides show-whitespaces -indent '│' -tab ' ' -tabpad ' ' -lf ' ' -spc ' ' -nbsp ' '\n"
        fi
    }
}

hook global WinCreate .* %{
    hook window WinSetOption filetype=.* kak-indent-guides-apply
    hook window BufWritePost .*         kak-indent-guides-apply
}

# ─────────────────────────────────────────────────────────────────────────────
# Filetype, indentation and formatting
# ─────────────────────────────────────────────────────────────────────────────

hook global WinSetOption filetype=(?:json|markdown|yaml|toml) %{
    set-option window tabstop 2
    set-option window indentwidth 2
    hook window -group expandtab InsertChar \t %{ execute-keys -draft -itersel h@ }
    hook -once -always window WinSetOption filetype=.* %{ remove-hooks window expandtab }
}

hook global BufSetOption filetype=(?:json|markdown|yaml) %{
    set-option buffer formatcmd "prettier --stdin-filepath '%val{buffile}'"
    hook buffer -group format-on-save BufWritePre .* format
}

hook global BufSetOption filetype=lua %{
    evaluate-commands %sh{
        command -v stylua >/dev/null 2>&1 &&
            printf "set-option buffer formatcmd %%{stylua --stdin-filepath '%s' -}\n" "$kak_buffile"
    }
}

# ─────────────────────────────────────────────────────────────────────────────
# LSP (kakoune-lsp)
# ─────────────────────────────────────────────────────────────────────────────
evaluate-commands %sh{
    if command -v kak-lsp >/dev/null 2>&1; then
        kak-lsp
    else
        echo "echo -debug 'kak-lsp not found on PATH: LSP features disabled'"
    fi
}

try %{
    set-option global modelinefmt "%opt{lsp_modeline} %opt{modelinefmt}"

    # ── Inlay hints (inferred types, param names). Comment out if too noisy. ──
    lsp-inlay-hints-enable global

    # ── Keybindings ──
    map global user l ':enter-user-mode lsp<ret>'        -docstring 'LSP mode'

    map global insert <tab> '<a-;>:try lsp-snippets-select-next-placeholders catch %{ execute-keys -with-hooks <lt>tab> }<ret>' -docstring 'snippet placeholder / tab'

    map global object a '<a-semicolon>lsp-object<ret>'                                   -docstring 'LSP any symbol'
    map global object f '<a-semicolon>lsp-object Function Method<ret>'                   -docstring 'LSP function/method'
    map global object t '<a-semicolon>lsp-object Class Interface Struct<ret>'            -docstring 'LSP type'
    map global object d '<a-semicolon>lsp-diagnostic-object error warning<ret>'          -docstring 'LSP diagnostics'
}

# ─────────────────────────────────────────────────────────────────────────────
# kak-ide — the IDE layer built to KAKOUNE-PARITY-PLAN.md
# ─────────────────────────────────────────────────────────────────────────────
source "%val{config}/plugins/kak-ide/rc/kak-ide.kak"

plug "andreyorst/kaktree" config %{
    require-module kaktree

    hook global WinSetOption filetype=kaktree %{
        remove-highlighter buffer/numbers
        remove-highlighter buffer/matching
        remove-highlighter buffer/wrap
        remove-highlighter buffer/show-whitespaces
        try %{ remove-highlighter window/indent-guides }
    }

    declare-option -docstring "command used to spawn a terminal for kaktree" \
        str termcmd 'kak-ide-termcmd'

    define-command -hidden -params 1.. kak-ide-termcmd %{
        nop %sh{
            if [ -n "${kak_client_env_WEZTERM_PANE:-}" ] && command -v wezterm >/dev/null 2>&1; then
                wezterm cli split-pane --left --percent 25 \
                    --cwd "${kak_client_env_PWD:-$PWD}" \
                    --pane-id "${kak_client_env_WEZTERM_PANE}" \
                    -- sh -c "$1" >/dev/null 2>&1
            else
                printf 'terminal sh -c %%{%s}\n' "$1" | kak -p "${kak_session}"
            fi
        }
    }

    define-command -override -docstring "kaktree-toggle: Toggle kaktree window on and off" \
    kaktree-toggle %{ evaluate-commands %sh{
        : "$kak_opt_kaktreeclient" "$kak_quoted_client_list" \
          "$kak_opt_kaktree__active" "$kak_opt_kaktree__onscreen"
        alive=no
        eval "set -- $kak_quoted_client_list"
        for c; do [ "$c" = "$kak_opt_kaktreeclient" ] && alive=yes; done

        if [ "$kak_opt_kaktree__active" = true ] && [ "$kak_opt_kaktree__onscreen" = true ] && [ "$alive" = yes ]; then
            printf "%s\n" "remove-hooks global kaktree-exit
                           evaluate-commands -client %opt{kaktreeclient} quit
                           set-option global kaktree__onscreen false"
        else
            printf "%s\n" "evaluate-commands kaktree-enable
                           set-option global kaktree__onscreen false
                           hook -group kaktree-exit global ClientClose ${kak_opt_kaktreeclient} %{ kaktree-disable }
                           evaluate-commands kaktree--display
                           set-option global kaktree__onscreen true"
        fi
    }}

    set-option global kaktree_double_click_duration '0.5'
    set-option global kaktree_indentation 1
    set-option global kaktree_dir_icon_open  '▾ 📂'
    set-option global kaktree_dir_icon_close '▸ 📁'
    set-option global kaktree_file_icon      '⠀⠀📄'
}

# ─────────────────────────────────────────────────────────────────────────────
# Tree-sitter (kak-tree-sitter): grammar-aware highlighting + structural selection
# ─────────────────────────────────────────────────────────────────────────────
evaluate-commands %sh{
    if command -v kak-tree-sitter >/dev/null 2>&1; then
        kak-tree-sitter -dks --init "${kak_session}"
    else
        echo "echo -debug 'kak-tree-sitter not found on PATH: tree-sitter highlighting disabled'"
    fi
}

kak-ide-keymap-treesitter-enable
kak-ide-keymap-git-enable

# ─────────────────────────────────────────────────────────────────────────────
# Fuzzy finding (fzf.kak)
# ─────────────────────────────────────────────────────────────────────────────
plug "andreyorst/fzf.kak" config %{
    require-module fzf
    require-module fzf-file
    require-module fzf-grep

    set-option global fzf_implementation      'fzf'
    set-option global fzf_file_command        'fd --type f --follow --hidden --exclude .git'
    set-option global fzf_grep_command        'rg --line-number --no-column --no-heading --color=never --smart-case '''''
    set-option global fzf_preview             true

    set-option global fzf_highlight_command %sh{
        if command -v bat >/dev/null 2>&1; then
            echo 'bat --color=always --style=numbers --paging=never {}'
        else
            echo 'cat {}'
        fi
    }
    set-option global fzf_grep_preview_command %sh{ command -v bat >/dev/null 2>&1 && echo bat || echo cat }

    set-option global fzf_preview_pos    'right'
    set-option global fzf_preview_width  '65%'
    set-option global fzf_preview_height '65%'   ;# used if pos is ever set to top/bottom

    set-option global fzf_preview_tmux_height '70%'
    set-option global fzf_tmux_height         '40%'

    declare-option -hidden str fzf_project_root_sh %{
        dir="${kak_buffile%/*}"
        [ -d "$dir" ] || dir="$PWD"
        root=$(cd "$dir" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)
        if [ -z "$root" ]; then
            d="$dir"
            while [ -n "$d" ] && [ "$d" != "/" ]; do
                for marker in .git .hg .svn .jj .project-root package.json go.mod Cargo.toml pyproject.toml Makefile; do
                    if [ -e "$d/$marker" ]; then root="$d"; break 2; fi
                done
                d="${d%/*}"
            done
        fi
        [ -n "$root" ] || root="$PWD"
    }

    define-command -docstring "fzf-project-files: fuzzy-find files under the current project root" \
    fzf-project-files %{
        require-module fzf
        evaluate-commands %sh{
            eval "$kak_opt_fzf_project_root_sh"
            if command -v fd >/dev/null 2>&1; then
                items="fd --type f --follow --hidden --exclude .git"
            elif command -v rg >/dev/null 2>&1; then
                items="rg -L --hidden --files --glob '!.git/*'"
            else
                items="find -L . -type f -not -path '*/.git/*'"
            fi
            printf "%s\n" "info -title %{fzf project files} %{root: ${root}}"
            printf "%s\n" "fzf -kak-cmd %{edit -existing} -preview -items-cmd %{cd '${root}' && ${items}} -filter %{sed 's|^|${root}/|'} -fzf-args %{--reverse}"
        }
    }

    define-command -docstring "fzf-project-grep: fuzzy-search file contents under the current project root" \
    fzf-project-grep %{
        require-module fzf
        evaluate-commands %sh{
            eval "$kak_opt_fzf_project_root_sh"
            if command -v rg >/dev/null 2>&1; then
                rg_cmd="rg --line-number --no-column --no-heading --color=never --smart-case --max-count=50"
                items="${rg_cmd} -- '' | head -n 2000"
                reload="--disabled --bind 'start:reload:${rg_cmd} -- {q} 2>/dev/null | head -n 2000' --bind 'change:reload:sleep 0.05; ${rg_cmd} -- {q} 2>/dev/null | head -n 2000'"
            else
                items="grep -RHn '' . | head -n 2000"
                reload=""
            fi
            if command -v bat >/dev/null 2>&1; then
                preview="-preview -preview-cmd %{--preview '(bat --color=always --style=plain --highlight-line {2} ${root}/{1} || cat ${root}/{1}) 2>/dev/null' --preview-window=\${pos}:+{2}-/2}"
            else
                preview="-preview -preview-cmd %{--preview 'cat ${root}/{1} 2>/dev/null' --preview-window=\${pos}:+{2}-/2}"
            fi
            printf "%s\n" "info -title %{fzf project grep} %{root: ${root}}"
            printf "%s\n" "fzf -kak-cmd %{evaluate-commands} ${preview} -items-cmd %{cd '${root}' && ${items} 2>/dev/null} -filter %{sed -E 's|([^:]+):([^:]+):.*|edit -existing ${root}/\\1; execute-keys \\2gvc|'} -fzf-args %{--reverse --delimiter=':' -n'3..' ${reload}}"
        }
    }

    # ── Bindings ──

    map global fzf 'P' ': fzf-project-files<ret>' -docstring 'find file in project (VCS root)'
    map global fzf 'G' ': fzf-project-grep<ret>'  -docstring 'grep in project (VCS root)'
}

# ─────────────────────────────────────────────────────────────────────────────
# New-user friendliness: "which-key" style discovery
# ─────────────────────────────────────────────────────────────────────────────
set-option global autoinfo command|onkey

map global user w ':write<ret>'           -docstring 'write (save)'
map global user W ':write-all<ret>'       -docstring 'write all buffers'
map global user q ':quit<ret>'            -docstring 'quit'
map global user x ':write-quit<ret>'      -docstring 'write & quit'
map global user = ':format<ret>'          -docstring 'format buffer'
map global user c ':comment-line<ret>'    -docstring 'toggle line comment'
map global user n ':buffer-next<ret>'     -docstring 'next buffer'
map global user p ':buffer-previous<ret>' -docstring 'previous buffer'
map global user d ':kak-ide-close-buffer<ret>' -docstring 'close buffer (asks if modified)'
map global user B ':buffer '              -docstring 'switch buffer (type name, <tab> completes)'
map global user ? ':new-user-tips<ret>'   -docstring 'quick cheat sheet'

# ── Pickers (,f files  ,/ search  ,b buffers) ──
map global user f ': fzf-project-files<ret>'                 -docstring 'find file in project'
map global user / ': fzf-project-grep<ret>'                  -docstring 'search in project'
map global user F ': require-module fzf-file; fzf-file buffile-dir<ret>' -docstring 'find file next to current buffer'
map global user b ': require-module fzf-buffer; fzf-buffer<ret>'         -docstring 'switch buffer (fzf)'
map global user r ': require-module fzf-recent; fzf-recent<ret>'         -docstring 'recent files'

define-command new-user-tips -docstring 'show a quick Kakoune cheat sheet' %{
    info -title 'Kakoune quick tips' %{Kakoune is "select first, then act":

  w  b  e      next word / back / end-of-word   (these SELECT, then you act)
  x            select the whole line (press again to add the next line)
  %            select the whole buffer
  /   ?        search forward / backward, then  n / N  for next / previous
  s            select every match inside the current selection
  d y c p      delete / yank / change / paste the selection
  u   <c-r>    undo / redo

Multiple cursors (Kakoune's superpower):
  C            add a cursor on the line below
  <a-s>        split the selection into one cursor per line
  ,            drop every selection except the main one

Everything below hangs off <space>, Kakoune's own leader key.

Finding things (project = the buffer's git root):
  <space>f     find file in project   <space>/   search project contents
  <space>b     switch buffer          <space>r   recent files
  <space>F     files beside this one  <space>e   file explorer

Splits (tmux panes sharing this session):
  <space>sv <space>ss   split right / below      <space>st  new tmux window
  <space>sh <space>sj <space>sk <space>sl   move focus left/down/up/right
  <space>sq <space>so   close this pane / close all others

Code (needs a language server):
  <space>l     LSP menu — definition, references, hover, rename, ...
  <space>a     code actions           <space>=   format buffer
  <space>)     next hunk / diagnostic / function
  <space>(     previous hunk / diagnostic / function

Discover more as you go:
  <space>      this leader menu       g  goto menu       v  view menu
  <a-i>/<a-a>  inner / whole object   [ ]  to object start / end
  :doc         the manual             :doc keys  the full key list}
}
