# ─────────────────────────────────────────────────────────────────────────────
# General editor behaviour
# ─────────────────────────────────────────────────────────────────────────────
set-option global tabstop 4
set-option global indentwidth 4
set-option global scrolloff 3,3
set-option -add global ui_options terminal_assistant=cat

# Use ripgrep for :grep if available
evaluate-commands %sh{ command -v rg >/dev/null 2>&1 && echo "set-option global grepcmd 'rg --column --line-number --no-heading --smart-case'" }

# ─────────────────────────────────────────────────────────────────────────────
# Plugins (plug.kak) — bootstrapped on first start, then `:plug-install`
# ─────────────────────────────────────────────────────────────────────────────
evaluate-commands %sh{
    plugins="$kak_config/plugins"
    mkdir -p "$plugins"
    [ ! -e "$plugins/plug.kak" ] && \
        git clone -q https://github.com/andreyorst/plug.kak.git "$plugins/plug.kak"
    printf "%s\n" "source '$plugins/plug.kak/rc/plug.kak'"
}
plug "andreyorst/plug.kak" noload

# ─────────────────────────────────────────────────────────────────────────────
# Appearance
# ─────────────────────────────────────────────────────────────────────────────
add-highlighter global/ number-lines -relative -hlcursor
add-highlighter global/ show-matching
add-highlighter global/ wrap -word -indent
# Flag trailing whitespace
add-highlighter global/ regex \h+$ 0:Error

# ─────────────────────────────────────────────────────────────────────────────
# Filetype, indentation and formatting
#
# The seven languages the parity plan targets — Rust, TypeScript, JavaScript,
# JSX, TSX, HTML, CSS (+SCSS/LESS) and Lua — are configured by kak-ide, which
# is sourced further down. Only the languages it does NOT cover are set here.
#
# (Kakoune already maps .mjs/.cjs/.mts/.cts itself, via `.*[.][cm]?(js|ts)x?`
#  in rc/filetype/javascript.kak, so the hooks that used to live here were
#  redundant. .jsx/.tsx are now given their own filetypes by kak-ide so that
#  kak-tree-sitter picks the JSX-capable query sets.)
# ─────────────────────────────────────────────────────────────────────────────

# Soft 2-space tabs for the config/markup languages kak-ide leaves alone.
hook global WinSetOption filetype=(?:json|markdown|yaml|toml) %{
    set-option window tabstop 2
    set-option window indentwidth 2
    # expandtab: convert an inserted tab into spaces based on tabstop
    hook window -group expandtab InsertChar \t %{ execute-keys -draft -itersel h@ }
    hook -once -always window WinSetOption filetype=.* %{ remove-hooks window expandtab }
}

hook global WinSetOption filetype=go %{
    set-option window tabstop 4
    set-option window indentwidth 0   ;# indent with real tabs
    set-option window aligntab true
}

# Format on save for the non-kak-ide languages. A failed formatter (e.g. a
# syntax error mid-edit) leaves the buffer untouched.
# NOTE ON QUOTING: Kakoune runs formatcmd via `eval "$kak_opt_formatcmd"` in a
# shell, so the value has to be finished shell. Written as %{...} — a raw
# string — a `%val{buffile}` inside it is never expanded and the formatter is
# handed the literal text "%val{buffile}", fails, and silently changes nothing.
# A "..." string expands at set time, which is what we want here.
hook global BufSetOption filetype=(?:json|markdown|yaml) %{
    set-option buffer formatcmd "prettier --stdin-filepath '%val{buffile}'"
    hook buffer -group format-on-save BufWritePre .* format
}

hook global BufSetOption filetype=go %{
    set-option buffer formatcmd gofmt
    hook buffer -group format-on-save BufWritePre .* format
}

# Lua: stylua wins over the language server's formatter when it is installed.
# kak-ide sets no formatcmd for Lua, so this simply fills that slot.
hook global BufSetOption filetype=lua %{
    evaluate-commands %sh{
        command -v stylua >/dev/null 2>&1 &&
            printf "set-option buffer formatcmd %%{stylua --stdin-filepath '%s' -}\n" "$kak_buffile"
    }
}

# ─────────────────────────────────────────────────────────────────────────────
# LSP (kakoune-lsp)
#   Wrapped so the config still loads cleanly if `kak-lsp` isn't installed.
# ─────────────────────────────────────────────────────────────────────────────
evaluate-commands %sh{
    if command -v kak-lsp >/dev/null 2>&1; then
        kak-lsp
    else
        echo "echo -debug 'kak-lsp not found on PATH: LSP features disabled'"
    fi
}

try %{
    # Show LSP breadcrumbs / diagnostics counts in the modeline
    set-option global modelinefmt "%opt{lsp_modeline} %opt{modelinefmt}"

    # Servers for Rust / TS / JS / JSX / TSX / HTML / CSS / Lua live in
    # plugins/kak-ide/rc/languages.kak, and Biome/ESLint/Prettier are attached
    # per project by plugins/kak-ide/rc/tooling.kak. kak-ide also enables LSP
    # per window (WinCreate), so no global `lsp-enable` is needed here.
    # Only the languages kak-ide does not cover are configured below.

    # ── Go ──
    hook global BufSetOption filetype=go %{
        set-option buffer lsp_servers %{
            [gopls]
            root_globs = ["go.mod", "go.work", ".git"]
            settings_section = "gopls"
            [gopls.settings.gopls]
            "hints.assignVariableTypes" = true
            "usePlaceholders"           = true
            "staticcheck"               = true
        }
        # Optional: let gopls organize imports on save instead of plain gofmt
        # hook buffer -group go-imports BufWritePre .* %{ lsp-code-action-sync '(?i)organize imports' }
    }

    # ── Markdown (optional; requires `marksman`) ──
    hook global BufSetOption filetype=markdown %{
        set-option buffer lsp_servers %{
            [marksman]
            root_globs = [".marksman.toml", ".git"]
            args = ["server"]
        }
    }

    # ── Inlay hints (inferred types, param names). Comment out if too noisy. ──
    lsp-inlay-hints-enable global

    # ── Keybindings ──
    map global user l ':enter-user-mode lsp<ret>'        -docstring 'LSP mode'
    # Symbol pickers — the "find by symbol" counterpart to the file pickers.
    # (kak-tree-sitter has no picker of its own; symbols come from the LSP.)
    map global user s '<esc>:lsp-document-symbol<ret>'   -docstring 'symbols in this file'
    map global user S '<esc>:lsp-workspace-symbol-incr<ret>' -docstring 'symbols in project'
    map global goto d '<esc>:lsp-definition<ret>'        -docstring 'definition'
    map global goto r '<esc>:lsp-references<ret>'        -docstring 'references'
    map global goto y '<esc>:lsp-type-definition<ret>'   -docstring 'type definition'

    # <tab> selects the next snippet placeholder, or inserts a normal tab otherwise
    map global insert <tab> '<a-;>:try lsp-snippets-select-next-placeholders catch %{ execute-keys -with-hooks <lt>tab> }<ret>' -docstring 'snippet placeholder / tab'

    # Object-mode selections driven by the language server
    map global object a '<a-semicolon>lsp-object<ret>'                                   -docstring 'LSP any symbol'
    map global object f '<a-semicolon>lsp-object Function Method<ret>'                   -docstring 'LSP function/method'
    map global object t '<a-semicolon>lsp-object Class Interface Struct<ret>'            -docstring 'LSP type'
    map global object d '<a-semicolon>lsp-diagnostic-object error warning<ret>'          -docstring 'LSP diagnostics'
}

# ─────────────────────────────────────────────────────────────────────────────
# kak-ide — the IDE layer built to KAKOUNE-PARITY-PLAN.md
#   Must come AFTER the `kak-lsp` block above (it extends lsp_servers) and
#   BEFORE kak-tree-sitter (it decides the filetypes tree-sitter keys off).
#   See plugins/kak-ide/README.md for what it provides and how to configure it.
# ─────────────────────────────────────────────────────────────────────────────
source "%val{config}/plugins/kak-ide/rc/kak-ide.kak"

# kaktree was installed but never referenced here, so the file explorer was
# dead weight. It needs perl (present) and a jump client to open files into.
plug "andreyorst/kaktree" config %{
    # kaktree declares its options inside `provide-module kaktree`, so they do
    # not exist until the module is required.
    require-module kaktree

    hook global WinSetOption filetype=kaktree %{
        remove-highlighter buffer/numbers
        remove-highlighter buffer/matching
        remove-highlighter buffer/wrap
        remove-highlighter buffer/show-whitespaces
    }
    set-option global kaktree_double_click_duration '0.5'
    set-option global kaktree_indentation 1
    set-option global kaktree_dir_icon_open  '▾ 📂'
    set-option global kaktree_dir_icon_close '▸ 📁'
    set-option global kaktree_file_icon      '⠀⠀📄'
}


# ─────────────────────────────────────────────────────────────────────────────
# Tree-sitter (kak-tree-sitter): grammar-aware highlighting + structural selection
# ─────────────────────────────────────────────────────────────────────────────
evaluate-commands %sh{
    if command -v kak-tree-sitter >/dev/null 2>&1; then
        kak-tree-sitter -dks --init "${kak_session}"
    else
        echo "echo -debug 'kak-tree-sitter not found on PATH: tree-sitter highlighting disabled'"
    fi
}
colorscheme night-owl        # uncomment once a tree-sitter theme is installed
# Opt-in keymap modules (kak-ide). These only surface capability that is
# already installed and was otherwise unreachable:
#   treesitter — kak-tree-sitter's 70 structural bindings, via `,t` + <a-o/i/n/p>
#   git        — Kakoune's native git.kak hunk nav (]c/[c) + a live diff gutter
# Helix-parity <space> leader stays off; run :kak-ide-keymap-helix-enable to try
# it (it relocates Kakoune's <space> to <a-space>).
kak-ide-keymap-treesitter-enable
kak-ide-keymap-git-enable

# kak-tree-sitter ships no mappings by default. For its semantic-selection user
# mode and object-mode (<a-i> / <a-a>) integration, see the "Usage" section of
# the manual: https://git.sr.ht/~hadronized/kak-tree-sitter

# ─────────────────────────────────────────────────────────────────────────────
# Fuzzy finding (fzf.kak)
#   `fd` lists files, `rg` greps, `bat` renders the preview when installed.
#   Everything below is *project aware*: the project root is the buffer's VCS
#   root (or nearest marker file), NOT the directory Kakoune was started in.
# ─────────────────────────────────────────────────────────────────────────────
plug "andreyorst/fzf.kak" config %{
    # These modules declare the options set below, so load them up front.
    # The rarer pickers (buffers, recent, projects, vcs) stay lazy.
    require-module fzf
    require-module fzf-file
    require-module fzf-grep

    set-option global fzf_implementation      'fzf'
    set-option global fzf_file_command        'fd --type f --follow --hidden --exclude .git'
    set-option global fzf_grep_command        'rg --line-number --no-column --no-heading --color=never --smart-case '''''
    set-option global fzf_preview             true

    # PREVIEW COMMAND — the `{}` matters.
    # fzf.kak special-cases the names bat/coderay/highlight/rouge/clp and passes
    # anything else through verbatim into `--preview '(<cmd> || cat {})'`. A bare
    # `cat` therefore becomes `cat` with NO argument, which reads stdin and
    # renders an empty preview pane. The fallback must name the file itself.
    set-option global fzf_highlight_command %sh{
        if command -v bat >/dev/null 2>&1; then
            echo 'bat --color=always --style=numbers --paging=never {}'
        else
            echo 'cat {}'
        fi
    }
    set-option global fzf_grep_preview_command %sh{ command -v bat >/dev/null 2>&1 && echo bat || echo cat }

    # PREVIEW LAYOUT — 35% file list / 65% preview.
    # `fzf_preview_pos auto` flips between a right split and a top split based on
    # the terminal's aspect ratio, so the width setting only applied some of the
    # time. Pin it to `right` so the 65% is what you actually get.
    set-option global fzf_preview_pos    'right'
    set-option global fzf_preview_width  '65%'
    set-option global fzf_preview_height '65%'   ;# used if pos is ever set to top/bottom

    # WINDOW SIZE — fzf runs in a new terminal, and Kakoune's default
    # `windowing_placement` is "window", i.e. a whole separate WezTerm window.
    # Split the current pane instead and give fzf 70% of it, so the picker is
    # large and stays in context. Falls back to Kakoune's own `terminal` when
    # not running under WezTerm.
    define-command -hidden -params 1.. kak-ide-fzf-terminal %{
        evaluate-commands %sh{
            if [ -n "${kak_client_env_WEZTERM_PANE:-}" ] && command -v wezterm >/dev/null 2>&1; then
                wezterm cli split-pane --bottom --percent 70 \
                    --cwd "${kak_client_env_PWD:-$PWD}" \
                    --pane-id "${kak_client_env_WEZTERM_PANE}" \
                    -- "$@" >/dev/null 2>&1
            else
                printf 'terminal %%arg{@}\n'
            fi
        }
    }
    set-option global fzf_terminal_command 'kak-ide-fzf-terminal'

    # Shell snippet shared by the project-scoped commands below: sets $root to
    # the VCS root of the current buffer, falling back to a marker file, then
    # to the server's working directory.
    declare-option -hidden str fzf_project_root_sh %{
        dir="${kak_buffile%/*}"
        [ -d "$dir" ] || dir="$PWD"
        root=$(cd "$dir" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)
        if [ -z "$root" ]; then
            d="$dir"
            while [ -n "$d" ] && [ "$d" != "/" ]; do
                for marker in .git .hg .svn .jj .project-root package.json go.mod Cargo.toml pyproject.toml Makefile; do
                    if [ -e "$d/$marker" ]; then root="$d"; break 2; fi
                done
                d="${d%/*}"
            done
        fi
        [ -n "$root" ] || root="$PWD"
    }

    define-command -docstring "fzf-project-files: fuzzy-find files under the current project root" \
    fzf-project-files %{
        require-module fzf
        evaluate-commands %sh{
            eval "$kak_opt_fzf_project_root_sh"
            if command -v fd >/dev/null 2>&1; then
                items="fd --type f --follow --hidden --exclude .git"
            elif command -v rg >/dev/null 2>&1; then
                items="rg -L --hidden --files --glob '!.git/*'"
            else
                items="find -L . -type f -not -path '*/.git/*'"
            fi
            printf "%s\n" "info -title %{fzf project files} %{root: ${root}}"
            printf "%s\n" "fzf -kak-cmd %{edit -existing} -preview -items-cmd %{cd '${root}' && ${items}} -filter %{sed 's|^|${root}/|'} -fzf-args %{--reverse}"
        }
    }

    define-command -docstring "fzf-project-grep: fuzzy-search file contents under the current project root" \
    fzf-project-grep %{
        require-module fzf
        evaluate-commands %sh{
            eval "$kak_opt_fzf_project_root_sh"
            if command -v rg >/dev/null 2>&1; then
                items="rg --line-number --no-column --no-heading --color=never ''"
            else
                items="grep -RHn '' ."
            fi
            if command -v bat >/dev/null 2>&1; then
                preview="-preview -preview-cmd %{--preview '(bat --color=always --style=plain --highlight-line {2} ${root}/{1} || cat ${root}/{1}) 2>/dev/null' --preview-window=\${pos}:+{2}-/2}"
            else
                preview="-preview -preview-cmd %{--preview 'cat ${root}/{1} 2>/dev/null' --preview-window=\${pos}:+{2}-/2}"
            fi
            printf "%s\n" "info -title %{fzf project grep} %{root: ${root}}"
            printf "%s\n" "fzf -kak-cmd %{evaluate-commands} ${preview} -items-cmd %{cd '${root}' && ${items} 2>/dev/null} -filter %{sed -E 's|([^:]+):([^:]+):.*|edit -existing ${root}/\\1; execute-keys \\2gvc|'} -fzf-args %{--reverse --delimiter=':' -n'3..'}"
        }
    }

    # ── Bindings ──
    # <c-p> is the one key worth stealing from normal mode: it is only bound in
    # insert mode (previous completion). <c-f> (page down) and <c-g> (cancel a
    # long-running operation) are deliberately left alone; the rest of the
    # pickers hang off the `,` leader menu below.
    map global normal <c-p> ': fzf-project-files<ret>' -docstring 'find file in project'

    # Project-scoped entries inside the fzf menu itself (,z or :fzf-mode),
    # alongside its built-ins: f file, b buffer, g grep, v git, r recent, c cd.
    map global fzf 'P' ': fzf-project-files<ret>' -docstring 'find file in project (VCS root)'
    map global fzf 'G' ': fzf-project-grep<ret>'  -docstring 'grep in project (VCS root)'
}

# ─────────────────────────────────────────────────────────────────────────────
# New-user friendliness: Helix-style "which-key" discovery
#
# When you enter a "mode" and pause, Kakoune pops up an info box listing the
# available keys and what they do — the same idea as Helix's Space menu.
# This already works out of the box for the built-in modes:
#     g              goto menu (gg top, ge end, gl line-end, ...)
#     v              view / scroll menu
#     <a-i> / <a-a>  "inner / around" object menu (then w, p, b, (, {, ...)
# Below we add a leader key so this config's own commands are discoverable too.
# `autoinfo` controls when these popups appear (onkey = show them for modes).
# ─────────────────────────────────────────────────────────────────────────────
set-option global autoinfo command|onkey

# Leader = comma. Press "," and wait — a menu of commands appears.
# (Helix users often prefer Space as the leader. Space is already bound in
#  Kakoune — it drops all but the main selection — so remap that first if you
#  want to reuse it as your leader.)
map global normal , ':enter-user-mode user<ret>' -docstring 'leader — show command menu'

# Each -docstring below is what shows up in the which-key popup.
map global user w ':write<ret>'           -docstring 'write (save)'
map global user W ':write-all<ret>'       -docstring 'write all buffers'
map global user q ':quit<ret>'            -docstring 'quit'
map global user x ':write-quit<ret>'      -docstring 'write & quit'
map global user = ':format<ret>'          -docstring 'format buffer'
map global user c ':comment-line<ret>'    -docstring 'toggle line comment'
map global user n ':buffer-next<ret>'     -docstring 'next buffer'
map global user p ':buffer-previous<ret>' -docstring 'previous buffer'
map global user d ':delete-buffer<ret>'   -docstring 'close buffer'
map global user B ':buffer '              -docstring 'switch buffer (type name, <tab> completes)'
map global user ? ':new-user-tips<ret>'   -docstring 'quick cheat sheet'

# ── Pickers (Helix-style: ,f files  ,/ search  ,b buffers) ──
map global user f ': fzf-project-files<ret>'                 -docstring 'find file in project'
map global user / ': fzf-project-grep<ret>'                  -docstring 'search in project'
map global user F ': require-module fzf-file; fzf-file buffile-dir<ret>' -docstring 'find file next to current buffer'
map global user b ': require-module fzf-buffer; fzf-buffer<ret>'         -docstring 'switch buffer (fzf)'
map global user r ': require-module fzf-recent; fzf-recent<ret>'         -docstring 'recent files'
map global user P ': require-module fzf-project; fzf-project<ret>'       -docstring 'switch project (saved list)'
map global user z ': fzf-mode<ret>'                                      -docstring 'fzf menu (all pickers)'
# ,l (LSP menu) is added in the LSP section above when kak-lsp is installed.

# A one-key cheat sheet of core Kakoune motions, for when the muscle memory
# isn't there yet. Trigger with ",?".
define-command new-user-tips -docstring 'show a quick Kakoune cheat sheet' %{
    info -title 'Kakoune quick tips' %{Kakoune is "select first, then act":

  w  b  e      next word / back / end-of-word   (these SELECT, then you act)
  x            select the whole line (press again to add the next line)
  %            select the whole buffer
  /   ?        search forward / backward, then  n / N  for next / previous
  s            select every match inside the current selection
  d y c p      delete / yank / change / paste the selection
  u   <c-r>    undo / redo

Multiple cursors (Kakoune's superpower):
  C            add a cursor on the line below
  <a-s>        split the selection into one cursor per line
  <space>      drop every selection except the main one

Fuzzy pickers (project = the buffer's git root):
  ,f  <c-p>    find file in project   ,/   search project contents
  ,b           switch buffer          ,r   recent files
  ,F           files beside this one  ,P   switch project
  ,s  ,S       symbols: this file / whole project
  ,z           the full fzf menu (git files, cd, buffer search, ...)

Discover more as you go:
  ,            this leader menu       g  goto menu       v  view menu
  <a-i>/<a-a>  object menu            :doc  the manual   :doc keys  key list}
}
