# ~/.config/kak/kakrc
# ============================================================
# Менеджер плагинов — kak-bundle
# https://codeberg.org/jdugan6240/kak-bundle
# ============================================================

# Бутстрап: если kak-bundle ещё не установлен — скачиваем при первом запуске
evaluate-commands %sh{
    plugins="$kak_config/bundle"
    mkdir -p "$plugins"
    [ ! -e "$plugins/kak-bundle" ] && \
        git clone -q https://codeberg.org/jdugan6240/kak-bundle "$plugins/kak-bundle"
    printf "%s\n" "source '$plugins/kak-bundle/rc/kak-bundle.kak'"
}
bundle-noload kak-bundle https://codeberg.org/jdugan6240/kak-bundle


# ------------------------------------------------------------
# LSP: автодополнение, goto-definition, диагностика, форматирование
# https://github.com/kakoune-lsp/kakoune-lsp
# ------------------------------------------------------------
bundle kakoune-lsp https://github.com/kakoune-lsp/kakoune-lsp %{
    eval %sh{kak-lsp}
    lsp-enable

    set-option global modelinefmt "%opt{lsp_modeline} %opt{modelinefmt}"

    map global user l ':enter-user-mode lsp<ret>' -docstring 'LSP mode'
    map global goto d '<esc>:lsp-definition<ret>'      -docstring 'LSP definition'
    map global goto r '<esc>:lsp-references<ret>'       -docstring 'LSP references'
    map global goto y '<esc>:lsp-type-definition<ret>'  -docstring 'LSP type definition'
}
# Собираем бинарник kak-lsp из исходников (нужен Rust/cargo);
# ~/.cargo/bin должен быть в $PATH
bundle-install-hook kakoune-lsp %{
    cargo install --locked --force --path .
}
bundle-cleaner kakoune-lsp %{
    rm -f ~/.cargo/bin/kak-lsp
}


# ------------------------------------------------------------
# Tree-sitter: семантическая подсветка и выделения (типы, функции…)
# Проект переехал с GitHub на SourceHut:
# https://git.sr.ht/~hadronized/kak-tree-sitter
#
# ВАЖНО: ставит сразу два бинарника (kak-tree-sitter и ktsctl).
# После первой установки один раз нужно вручную выполнить, например:
#   ktsctl sync rust python go
# чтобы подтянуть грамматики — kak-bundle это не делает автоматически.
# Без темы, понимающей tree-sitter (см. kakoune-tree-sitter-themes),
# подсветки не будет.
# ------------------------------------------------------------
bundle kak-tree-sitter https://git.sr.ht/~hadronized/kak-tree-sitter %{
    eval %sh{
        kak-tree-sitter --init "${kak_session}" --kakoune --daemonize --server --with-highlighting
    }
}
bundle-install-hook kak-tree-sitter %{
    cargo install --locked --force --path kak-tree-sitter
    cargo install --locked --force --path ktsctl
}


# ------------------------------------------------------------
# Поиск: peneira — нативный fuzzy-finder без внешних зависимостей
# (в отличие от fzf.kak, который archived, peneira активно поддерживается)
# https://github.com/gustavo-hms/peneira
# ------------------------------------------------------------
bundle luar "gustavo-hms/luar" %{
    require-module luar
}
bundle peneira "gustavo-hms/peneira" %{
    require-module peneira

    map global normal <c-p> ': peneira-files<ret>'   -docstring 'найти файл'
    map global normal <c-b> ': peneira-buffers<ret>' -docstring 'переключить буфер'
}


# ------------------------------------------------------------
# Редактирование
# ------------------------------------------------------------

# Автозакрытие скобок и кавычек
bundle auto-pairs "alexherbo2/auto-pairs.kak" %{
    require-module auto-pairs
    hook global WinCreate .* auto-pairs-enable
}

# Удобная навигация между буферами
bundle kakoune-buffers "Delapouite/kakoune-buffers" %{
    map global user b ':enter-buffers-mode<ret>' -docstring 'buffers…'
}

# Сниппеты + готовая коллекция под разные языки
bundle kakoune-snippets "occivink/kakoune-snippets" %{
    require-module snippets
}
bundle kakoune-snippet-collection "andreyorst/kakoune-snippet-collection" %{
    set-option -add global snippets_directories \
        "%val{config}/bundle/kakoune-snippet-collection/snippets"
}


# ------------------------------------------------------------
# Тема
# ------------------------------------------------------------
bundle-theme kakoune-themes "anhsirk0/kakoune-themes"
# после установки выбрать конкретную схему, например:
# colorscheme modus-operandi


