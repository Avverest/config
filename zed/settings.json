{
  "agent": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-haiku-4.5",
      "enable_thinking": true
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "agent_servers": {
    "cursor": {
      "type": "registry"
    }
  },
  "document_folding_ranges": "on",
  "disable_ai": false,
  "code_actions_on_format": {
    "source.organizeImports.biome": true,
    "source.fixAll.biome": true
  },
 "formatter": [],
 "edit_predictions": null,
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Latte"
  },
  "title_bar": {
    "show_branch_icon": true,
    "show_branch_name": true,
    "show_menus": false,
    "show_onboarding_banner": false,
    "show_sign_in": false,
    "show_project_items": true
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false
  },
  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 200,
      "padding": 2,
      "min_column": 0,
      "max_severity": null
    }
  },
  "cursor_blink": false,
  "tabs": {
    "git_status": true,
    "file_icons": true,
    "show_diagnostics": "all"
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
    "show": true,
  },
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light Soft",
    "dark": "One Dark"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  "helix_mode": false,
  "ui_font_size": 18,
  "ui_font_family": "Iosevka",
  "buffer_font_size": 19,
  "buffer_font_family": "Iosevka",
  "buffer_line_height": { "custom": 1.3 },
  "buffer_font_weight": 300,
  "ui_font_weight": 500,
  "preferred_line_length": 100,
  "show_whitespaces": "boundary",
  "scrollbar": {
    "show": "never",
  },
  "project_panel": {
    "dock": "right",
    "scrollbar": {
      "show": "never"
    }
  },
  "tab_size": 2,
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_file_finder": true,
    "enable_keep_preview_on_code_navigation": true
  },
  "unnecessary_code_fade": 0.5,
  "inlay_hints": {
    "enabled": true,
    "show_other_hints": true
  },
  "bottom_dock_layout": null,
  "format_on_save": "off",
  "lsp": {
    "eslint": {
      "settings": {
        "workingDirectory": {
          "mode": "auto"
        }
      }
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    }
  },
  "languages": {
    "TypeScript": {
      "formatter": {
        "external": {
          // "command": "biome",
          // "arguments": ["check", "--write", "--stdin-file-path", "{buffer_path}"]
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "TSX": {
      "formatter": {
        "external": {
          // "command": "biome",
          // "arguments": ["check", "--write", "--stdin-file-path", "{buffer_path}"]
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "JavaScript": {
      "formatter": {
        "external": {
          // "command": "biome",
          // "arguments": ["check", "--write", "--stdin-file-path", "{buffer_path}"]
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "JSON": {
      "formatter": {
        "external": {
          "command": "biome",
          "arguments": ["check", "--write", "--stdin-file-path", "{buffer_path}"]
        }
      }
    }
  }
}
