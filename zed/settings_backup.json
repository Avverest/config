{
  "collaboration_panel": {
    "dock": "right"
  },
  "languages": {
    "TSX": {
      "show_edit_predictions": true
    }
  },
  "show_edit_predictions": true,
  "git_panel": {
    "dock": "left",
    "tree_view": false,
  },
  "outline_panel": {
    "dock": "right",
  },
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6",
      "enable_thinking": true,
      "effort": "max"
    },
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "claude-haiku-4.5",
      "enable_thinking": true,
    },
    "commit_message_model": {
      "provider": "anthropic",
      "model": "claude-haiku-4-5",
    },
  },
  "agent_servers": {
    "cursor": {
      "type": "registry",
    },
  },
  "document_folding_ranges": "on",
  "disable_ai": false,
  "code_actions_on_format": {
    "source.organizeImports.biome": true,
    "source.fixAll.biome": true,
  },
  "edit_predictions": {
    "mode": "eager",
  },
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "title_bar": {
    "show_branch_icon": true,
    "show_branch_name": true,
    "show_menus": false,
    "show_onboarding_banner": false,
    "show_sign_in": false,
    "show_project_items": true,
  },
  "colorize_brackets": true,
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "code_actions": true,
    "agent_review": true,
  },
  "status_bar": {
    "experimental.show": true,
  },
  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 300,
      "padding": 4,
      "min_column": 1,
      "max_severity": null,
    },
  },
  "gutter": {
    "breakpoints": false,
    "line_numbers": true,
    "folds": false,
    "runnables": false,
    "min_line_number_digits": 2,
  },
  "line_indicator_format": "short",
  "relative_line_numbers": "enabled",
  "inline_code_actions": false,
  "cursor_blink": false,
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
    "show": true,
  },
  "theme": {
    "mode": "light",
    "light": "Spiceflow Light",
    "dark": "Spiceflow Dark",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "vim_mode": false,
  "helix_mode": true,
  "ui_font_size": 18,
  "ui_font_family": "Iosevka",
  "buffer_font_size": 23,
  "buffer_font_family": "Iosevka",
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 250,
  "ui_font_weight": 250,
  "preferred_line_length": 100,
  "show_whitespaces": "none",
  "whitespace_map": {
    // "space": "⍽"
    "space": "·",
  },
  "scrollbar": {
    "show": "never",
  },
  "project_panel": {
    "dock": "left",
    "scrollbar": {
      "show": "never",
    },
  },
  "terminal": {
    "font_weight": 250,
  },
  "tab_size": 2,
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_file_finder": true,
    "enable_keep_preview_on_code_navigation": true,
  },
  "agent_ui_font_size": 20,
  "agent_buffer_font_size": 20,
  "unnecessary_code_fade": 0.5,
  "inlay_hints": {
    "enabled": false,
    "show_other_hints": false,
  },
  "bottom_dock_layout": null,
  "format_on_save": "off",
  "lsp": {
    "eslint": {
      "settings": {
        "workingDirectory": {
          "mode": "auto",
        },
      },
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
}
